---
layout: base.njk
---

{% include "header.njk" %}

<article>
    <section>
        <h1 class="title">{{ title }}</h1>
        <p class="subtitle">
            <strong>{{ date | formatDate("%d %B %Y") }}</strong>
        </p>

        {% if tags %}
        <!-- Make the following ul list items appear inline -->
        <ul style="list-style-type: none; padding: 0; margin: 0">
            {% for tag in tags %}
            <li style="display: inline-block; padding-right: 0.334rem">
                <a href="/tags/{{ tag | slug }}"><em>#{{ tag }}</em></a>
            </li>
            {% endfor %}
        </ul>
        {% endif %}

        {{ content | safe }}
    </section>
</article>
