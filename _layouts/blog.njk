---
layout: base.njk
---

{% include "header.njk" %}

<h1 class="title">{{ title }}</h1>

{# Group pages by year #}
{% set pagesByYear = collections[collectionName] | groupByYear %}
{% for year, posts in pagesByYear %}
<h2>{{ year }}</h2>
<ul>
    {% for page in posts %}
    <li>
        <a href="{{ page.url }}">{{ page.data.title }}</a>
        {% set tags = page.data.tags %}
        {% include "tags.njk" %}
    </li>
    {% endfor %}
</ul>
{% endfor %}
